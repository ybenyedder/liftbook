<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup & device-to-device transfer: session tokens and the
     workout draft never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="draft.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="draft.xml" />
    </device-transfer>
</data-extraction-rules>
